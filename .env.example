# Stripe — required for /chair-yoga-foundations checkout to work.
# Confirm the Stripe account's registration country and international-charge
# history before relying on this (see docs/growth-plan.md section 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for the two checkout options (create these in the Stripe
# dashboard: one for the $49 course-only price, one for the $65 course+pack
# bundle price).
NEXT_PUBLIC_STRIPE_PRICE_COURSE_ONLY=
NEXT_PUBLIC_STRIPE_PRICE_COURSE_BUNDLE=
